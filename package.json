{
  "name": "academic-obsidian",
  "version": "4.5.0",
  "description": "Academic Obsidian — LaTeX-Grade PDF Export Plugin",
  "author": "Giacomo Berti",
  "repository": {
    "type": "git",
    "url": "https://github.com/bertigiacomo/academic-obsidian"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "0.25.5",
    "obsidian": "^1.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "allowScripts": {
    "esbuild@0.25.5": true
  }
}
